[Unit]
Description=ocrsnip：热键框选 OCR 到剪贴板
Documentation=https://github.com/chendx/ocr-snip
# 崩溃立即重启，但别无限重启打爆系统
StartLimitIntervalSec=60
StartLimitBurst=10
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@EXEC@ daemon --ui qt
Restart=always
RestartSec=2
# Qt 需要能连上 X11；DISPLAY 由 ocrsnip 自己从会话里探测，这里不做限制
Environment=PYTHONUNBUFFERED=1
Nice=5

[Install]
WantedBy=default.target
